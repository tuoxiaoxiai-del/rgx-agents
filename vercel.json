{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "books/**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/books/(.*)",
      "dest": "/books/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}