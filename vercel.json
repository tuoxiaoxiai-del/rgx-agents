{
  "version": 2,
  "rewrites": [
    { "source": "/((?!assets/|books/|CNAME|vercel.json|favicon.ico|robots.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}